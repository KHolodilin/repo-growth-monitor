# Required for docker-compose.yml (real GitHub)
GITHUB_TOKEN=github_pat_replace_me

# Auth: mock | zitadel | keycloak (required)
AUTH_PROVIDER=mock
# AUTH_PRODUCTION=false
# AUTH_SESSION_IDLE=8h
# AUTH_SESSION_ABSOLUTE=24h
# AUTH_OIDC_ISSUER_URI=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_REDIRECT_URI=
# SPRINGDOC_API_DOCS_ENABLED=true
# SPRINGDOC_SWAGGER_UI_ENABLED=true

# Optional
# APP_TIMEZONE=UTC
# COLLECTION_PLANNER_FROM=06:00
# COLLECTION_PLANNER_TO=18:00
