# Required. Fine-grained PAT: Contents/Metadata Read; Traffic needs Administration: Read
GITHUB_TOKEN=github_pat_replace_me

# Required. Postgres superuser (migrate) password.
POSTGRES_PASSWORD=replace_me

# Runtime DB role (no DDL). Defaults to POSTGRES_PASSWORD if unset.
POSTGRES_RUNTIME_USER=repogrowth
POSTGRES_RUNTIME_PASSWORD=replace_me_runtime

# Auth: mock | zitadel | keycloak (required). Production must not use mock.
AUTH_PROVIDER=mock
AUTH_PRODUCTION=false
# AUTH_OIDC_ISSUER_URI=https://your-instance.zitadel.cloud
# AUTH_OIDC_CLIENT_ID=replace_me
# AUTH_OIDC_CLIENT_SECRET=replace_me
# AUTH_OIDC_REDIRECT_URI=https://your.host/login/oauth2/code/oidc

# Without a domain use docker-compose.local.yml (HTTP on :80, cookies not Secure).
# With a domain, set these and use docker-compose.yml only:
# SITE_DOMAIN=monitor.example.com
# APP_BASE_URL=https://monitor.example.com
# AUTH_COOKIE_SECURE=true
# CADDY_ACME_EMAIL=you@example.com
# AUTH_PROVIDER=zitadel
# AUTH_PRODUCTION=true

# Optional management basic-auth (Actuator on 127.0.0.1:8081)
# MANAGEMENT_USER=actuator
# MANAGEMENT_PASSWORD=replace_me

# Optional
# APP_IMAGE=ghcr.io/kholodilin/repo-growth-monitor:0.30.1
# APP_TIMEZONE=UTC
# COLLECTION_PLANNER_FROM=06:00
# COLLECTION_PLANNER_TO=18:00
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
