<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- generation++ under this.lock in claim; volatile for unlocked readers of Job state. -->
  <Match>
    <Class name="com.kholodilin.collector.repository.InMemoryJobQueue"/>
    <Method
        name="claim"
        params="java.lang.String,java.time.Duration"
        returns="java.util.Optional"/>
    <Bug pattern="VO_VOLATILE_INCREMENT"/>
  </Match>

  <!-- failures++ under this.lock in the 3-arg retry overload when countFailure is true. -->
  <Match>
    <Class name="com.kholodilin.collector.repository.InMemoryJobQueue"/>
    <Method
        name="retry"
        params="com.kholodilin.collector.repository.JobQueue$Lease,java.time.Instant,boolean"
        returns="boolean"/>
    <Bug pattern="VO_VOLATILE_INCREMENT"/>
  </Match>

  <!-- deliveryGeneration++ under this.lock when claiming a delivery lease. -->
  <Match>
    <Class name="com.kholodilin.collector.repository.InMemoryJobQueue"/>
    <Method
        name="claimDelivery"
        params="java.lang.String,java.time.Duration"
        returns="java.util.Optional"/>
    <Bug pattern="VO_VOLATILE_INCREMENT"/>
  </Match>

  <!-- deliveryGeneration++ under this.lock when requeueing a delivery. -->
  <Match>
    <Class name="com.kholodilin.collector.repository.InMemoryJobQueue"/>
    <Method
        name="requeueDelivery"
        params="java.util.UUID,java.lang.String"
        returns="boolean"/>
    <Bug pattern="VO_VOLATILE_INCREMENT"/>
  </Match>
</FindBugsFilter>
